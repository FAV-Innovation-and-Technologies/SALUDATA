{
  "name": "saludata-fhir-api",
  "version": "2.1.0",
  "description": "FHIR Facade Server implementing @bluehalo/node-fhir-server-core",
  "main": "src/index.js",
  "contributors": [
    "Robert Winterbottom <rwinterbottom@asymmetrik.com>",
    "Jon Lee <jlee@asymmetrik.com>",
    "Shane O'Neill <soneill@asymmetrik.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/patch-kafkajs-request-queue.js",
    "start": "node src/index.js",
    "nodemon": "cross-env NODE_ENV=development node scripts/nodemon.js",
    "test": "npm run test:jest -- --runInBand",
    "test:lint": "eslint \"src/**/*.js\" --quiet",
    "test:jest": "jest --forceExit",
    "prettier-check": "prettier --check \"**/*.{js,mjs,cjs,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,less,graphql,graphqls,gql}\"",
    "prettier-fix": "prettier --write \"**/*.{js,mjs,cjs,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,less,graphql,graphqls,gql}\"",
    "generate-token": "node scripts/generate-test-token.js",
    "test:integration": "node scripts/test-integration.js",
    "check": "npm run test:lint && npm test && node ci/step1/validate_ci.js"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "collectCoverage": false,
    "coverageReporters": [
      "text",
      "lcov",
      "json"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/testutils/"
    ]
  },
  "dependencies": {
    "@bluehalo/node-fhir-server-core": "^2.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "cors": "2.8.5",
    "dotenv": "^17.2.1",
    "express": "4.22.3",
    "fast-json-patch": "^3.1.1",
    "helmet": "7.2.0",
    "kafkajs": "^2.2.4",
    "moment-timezone": "^0.5.45",
    "mongodb": "^6.8.1",
    "multer": "^1.4.5-lts.1",
    "object-hash": "^3.0.0",
    "passport": "0.7.0",
    "passport-http-bearer": "^1.0.1",
    "superagent": "10.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "var": "^0.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.9",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  },
  "private": true
}
