# Configuración de MongoDB
MONGO_HOSTNAME=localhost
MONGO_DB_NAME=fhir
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# En despliegue, preferir una URI completa inyectada por el gestor de secretos.
# Nunca se registra ni se versiona su valor.
# MONGO_URI=mongodb://user:password@mongo.example.invalid/fhir_step1?authSource=admin
# Todo host no local exige TLS y una CA explícita. El PEM cliente es opcional
# para instalaciones mTLS y debe contener certificado + clave privada.
MONGO_TLS=false
# MONGO_TLS_CA_FILE=/run/secrets/mongo/ca.crt
# MONGO_TLS_CERTIFICATE_KEY_FILE=/run/secrets/mongo/client.pem
# No se permite desactivar la validación del certificado.
MONGO_TLS_ALLOW_INVALID_CERTIFICATES=false

# Para desarrollo local con Docker
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password

# Configuración del servidor
SERVER_PORT=3000
# URL pública base del API. Si no se define en la infra, Swagger usará el host
# desde el que se abra /api-docs para que Try it out no apunte a localhost.
# En dev remoto: RESOURCE_SERVER=https://fhir.example.invalid
RESOURCE_SERVER=
AUTH_SERVER_URI=http://auth.example.invalid

# Configuración de autenticación
FHIR_AUTH_ENABLED=false
# Legacy alert/upload handlers are outside the generated FHIR router. Keep
# disabled in Step 1; enable explicitly only when a legacy integration needs them.
FHIR_LEGACY_ENDPOINTS_ENABLED=false
CLIENT_ID=client
CLIENT_SECRET=secret
INTROSPECTION_URL=https://auth.example.invalid/introspect

# Configuración de CORS
WHITELIST=http://localhost

# Nivel de logging
LOGGING_LEVEL=debug

# Saludata Sports ECG ingestion
SUPABASE_URL=
SUPABASE_ANON_KEY=
SPORTS_REALTIME_TOPIC=saludata.sports.ecg.realtime
SPORTS_POST_SESSION_TOPIC=saludata.sports.ecg.post_session
SPORTS_MODEL_EVENTS_TOPIC=saludata.sports.ecg.model_events
SPORTS_ECG_CHUNK_LIMIT=50mb
# Keep disabled until a model/stream processor is deployed.
SPORTS_ECG_EVENT_PUBLISHING_ENABLED=false

# Monitoring pipeline v1 (Step 1: synthetic shadow mode only)
# Keep disabled unless this isolated ingestion endpoint is intentionally used.
MONITORING_INGESTION_MODE=disabled
MONITORING_MEASUREMENTS_TOPIC=saludata.measurements.pseud.v1
MONITORING_KAFKA_PUBLISHING_ENABLED=true
MONITORING_OUTBOX_INTERVAL_MS=5000
# En el clúster sintético, el BFF debe autenticarse además de estar limitado por
# NetworkPolicy. El token se inyecta desde el gestor de secretos.
MONITORING_SYNTHETIC_AUTH_REQUIRED=false
# MONITORING_SYNTHETIC_BEARER_TOKEN=

# Canonical patient resolution for the FHIR Observation shadow adapter. These
# server-only settings route the Supabase user identifier through the same
# HMAC-protected Monitoring provisioning service used by patient provisioning.
# The adapter fails closed when any one is unavailable and never changes consent.
# MONITORING_PROVISION_URL=http://monitoring.example.invalid:8000/internal/v1/patients/provision
# MONITORING_PROVISION_TOKEN=
# MONITORING_IDENTITY_HMAC_KEY=
# MONITORING_PROVISIONING_CLINICIAN_ACTOR_REF=usr_00000000000000000000000000000000
# PATIENT_PROVISIONING_UPSTREAM_TIMEOUT_MS=5000

# Comma-separated exact browser origins. There is no wildcard default.
# WHITELIST=https://app.example.invalid

# Shared Kafka client. The monitoring outbox uses this producer when enabled.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fhir-api-service
# PLAINTEXT is accepted only for loopback/local container brokers.
# Non-local brokers fail closed unless SSL or SASL_SSL is configured.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SSL_CA_LOCATION=/run/secrets/kafka-ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/run/secrets/kafka-client.pem
# KAFKA_SSL_KEY_LOCATION=/run/secrets/kafka-client-key.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
